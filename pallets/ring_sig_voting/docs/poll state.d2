direction: down

classes: {
  process: {
    shape: rectangle
    style: {
      border-radius: 8
      fill: "#e3f2fd"
      stroke: "#1565c0"
      stroke-width: 2
    }
  }
  intermediate: {
    shape: diamond
    style: {
      fill: "#fff3e0"
      stroke: "#ef6c00"
      stroke-width: 2
    }
  }
  success: {
    shape: rectangle
    style: {
      border-radius: 8
      fill: "#e8f5e9"
      stroke: "#2e7d32"
      stroke-width: 2
    }
  }
  failure: {
    shape: parallelogram
    style: {
      fill: "#ffebee"
      stroke: "#c62828"
      stroke-width: 2
      stroke-dash: 3
    }
  }
}

# 1. 定义节点
Active: {
  class: process
  label: Active
}

Paused: {
  class: intermediate
  label: Paused
}

Tallying: {
  class: process
  label: Tallying
}

# 2. 终态容器（让它们待在底部）
Final States: {
  label: ""
  style: {stroke-width: 0; fill: transparent}

  Completed: {
    class: success
    label: Completed
  }

  Cancelled: {
    class: failure
    label: Cancelled
  }
}

# 3. 核心流转 (Happy Path & Loop)
Active -> Tallying: tally_poll() or schedule
Tallying -> Final States.Completed: Verify Proof

# 暂停逻辑（双向箭头保持紧凑）
Active <-> Paused: paused_poll()/active_poll()
Tallying <-> Paused: paused_poll()/tally_poll()

# 4. 关键修改：多源到单目标的终止流程
Active -> Final States.Cancelled: {
  label: cancel_poll()
  style: {
    stroke: "#c62828"
    stroke-dash: 3
  }
}

Paused -> Final States.Cancelled: {
  label: cancel_poll()
  style: {
    stroke: "#c62828"
    stroke-dash: 3
  }
}

Tallying -> Final States.Cancelled: {
  label: cancel_poll()
  style: {
    stroke: "#c62828"
    stroke-dash: 3
  }
}

# 布局微调
Paused.near: Active
