direction: down
vars: {
  d2-config: {
    layout-engine: dagre
  }
}

# --- 统一样式定义 ---
classes: {
  extrinsic: {
    shape: parallelogram
    style: {
      fill: "#e3f2fd"
      stroke: "#1565c0"
      stroke-width: 2
      font-size: 14
    }
  }
  logic: {
    shape: diamond
    style: {
      fill: "#fff3e0"
      stroke: "#ef6c00"
    }
  }
  process: {
    shape: rectangle
    style: {
      fill: "#f3e5f5"
      stroke: "#7b1fa2"
      border-radius: 4
    }
  }
  storage: {
    shape: cylinder
    style: {
      fill: "#e0f2f1"
      stroke: "#00695c"
      shadow: true
    }
  }
  success: {
    shape: circle
    style: {
      fill: "#c8e6c9"
      stroke: "#2e7d32"
      font-size: 16
    }
  }
  error: {
    shape: hexagon
    style: {
      fill: "#ffebee"
      stroke: "#c62828"
      font-size: 12
    }
  }
}

# --- 节点定义 ---

# 1. 输入
Input: 收到交易 create_poll() {
  class: extrinsic
  label: "Extrinsic: create_poll\n(origin, ring_id, desc, meta, deadline, pub_key)"
}

# 2. 基础检查
CheckAdmin: 权限检查 {
  class: logic
  label: "ensure_admin(origin)?"
}

CheckRing: Ring 存在性 {
  class: storage
  label: "Rings.contains(ring_id)?"
}

CheckDesc: 描述长度 {
  class: logic
  label: "desc.len() <= Max?"
}

# 3. 逻辑处理
GetID: 获取 Poll ID {
  class: storage
  label: "Read: PollCount"
}

HashMeta: 处理元数据 {
  class: process
  label: "Preimage::note(meta)"
  tooltip: "将元数据存储到 Preimage Pallet 并获取 Hash"
}

NewPoll: 构造 Poll 对象 {
  class: process
  label: "Poll::new(...)"
  tooltip: "初始化 Poll 结构体"
}

CheckDeadline: 截止时间检查 {
  class: logic
  label: "deadline > now?"
  tooltip: "在 Poll::new 内部执行"
}

# 4. 存储
StorePoll: 存储 Poll {
  class: storage
  label: "Insert: Polls\n(id, poll)"
}

IncID: 更新计数器 {
  class: storage
  label: "Update: PollCount\n(id + 1)"
}

EmitEvent: 发送事件 {
  class: process
  label: "Event: PollCreated"
}

EndOK: 流程结束 {
  class: success
  label: "Success"
}

# 错误节点
ErrPerm: Error: BadOrigin {class: error}
ErrRing: Error: RingNotFound {class: error}
ErrDesc: Error: DescriptionTooLong {class: error}
ErrDeadline: Error: InvalidDeadline {class: error}

# --- 连线逻辑 ---

Input -> CheckAdmin
CheckAdmin -> CheckRing: "Yes"
CheckAdmin -> ErrPerm: "No"

CheckRing -> CheckDesc: "Yes"
CheckRing -> ErrRing: "No"

CheckDesc -> GetID: "Valid"
CheckDesc -> ErrDesc: "Too Long"

GetID -> HashMeta
HashMeta -> NewPoll
NewPoll -> CheckDeadline

CheckDeadline -> StorePoll: "Valid"
CheckDeadline -> ErrDeadline: "Expired"

StorePoll -> IncID
IncID -> EmitEvent
EmitEvent -> EndOK
